@page
@model frontend.Pages.Teacher.DashboardModel
@{
    ViewData["Title"] = "Tableau de bord enseignant";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/wordcloud@1.1.0/src/wordcloud2.min.js"></script>

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f5f6fa;
            padding: 30px;
            margin: 0;
            position: relative;
        }

        .dashboard {
            max-width: 1000px;
            margin: auto;
        }

        h2 {
            margin-bottom: 30px;
            text-align: center;
            color: #333;
        }

        .card {
            background: #fff;
            padding: 25px;
            margin-bottom: 30px;
            border-radius: 8px;
            box-shadow: 0 3px 6px rgba(0,0,0,0.1);
        }

        canvas {
            max-width: 100%;
            height: auto;
        }

        #wordCloud {
            width: 100%;
            height: 300px;
        }

        /* Bouton de déconnexion fixé en haut à droite */
        .logout-button {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #f44336;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s;
        }

        .logout-button:hover {
            background-color: #d32f2f;
        }
    </style>
</head>
<body>
    <div class="dashboard">
        <h2>📊 Tableau de bord Enseignant</h2>

        <!-- Formulaire de déconnexion en haut à droite -->
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="logout-button">Se déconnecter</button>
        </form>

        <div class="card">
            <h4>📚 Moyenne des notes par cours</h4>
            <canvas id="barChart"></canvas>
        </div>

        <div class="card">
            <h4>💬 Nuage de mots des commentaires</h4>
            <div id="wordCloud"></div>
        </div>
    </div>

    <script>
        const coursStats = @Html.Raw(Json.Serialize(Model.CoursStats));
        const topWords = @Html.Raw(Json.Serialize(Model.TopWords));

        // Chart.js - Bar chart
        const ctx = document.getElementById('barChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: coursStats.map(c => c.titre),
                datasets: [{
                    label: 'Moyenne des notes',
                    data: coursStats.map(c => c.moyenneNote),
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        min: 0,
                        max: 5,
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: "Note /5"
                        }
                    }
                }
            }
        });

        // WordCloud
        const wordCloudData = Object.entries(topWords).map(([word, freq]) => [word, freq]);
        WordCloud(document.getElementById('wordCloud'), {
            list: wordCloudData,
            gridSize: 10,
            weightFactor: 10,
            color: 'random-dark',
            rotateRatio: 0.5,
            backgroundColor: '#fff'
        });
    </script>
</body>
</html>
