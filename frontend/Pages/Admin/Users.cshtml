@page
@model frontend.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Gestion des Utilisateurs";
}

<style>
    .titre-section {
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .table-utilisateurs {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #D1D5DB; /* gris clair */
    }

    .entete-tableau {
        background-color: #E5E7EB; /* fond gris clair */
    }

    .entete-tableau th,
    .ligne-utilisateur td {
        padding: 0.5rem 1rem;
        border-top: 1px solid #D1D5DB;
        text-align: left;
    }

    .ligne-utilisateur td {
        vertical-align: middle;
    }

    .btn-supprimer {
        background-color: #EF4444;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 0.25rem;
        border: none;
        cursor: pointer;
    }

    .btn-supprimer:hover {
        background-color: #DC2626;
    }

    .form-role {
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
    }

    .select-role {
        border: 1px solid #D1D5DB;
        border-radius: 0.25rem;
        padding: 0.25rem 0.5rem;
        margin-right: 0.5rem;
    }

    .btn-modifier {
        background-color: #3B82F6;
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        border: none;
        cursor: pointer;
    }

    .btn-modifier:hover {
        background-color: #2563EB;
    }

    p {
        margin-top: 1rem;
    }
</style>

<h2 class="titre-section">👥 Utilisateurs</h2>

@if (Model.Users?.Count > 0)
{
    <table class="table-utilisateurs">
        <thead>
            <tr class="entete-tableau">
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr class="ligne-utilisateur">
                    <td>@user.Nom</td>
                    <td>@user.Prenom</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" onsubmit="return confirm('Confirmer la suppression ?');">
                            <button type="submit" class="btn-supprimer">🗑 Supprimer</button>
                        </form>
                        <form method="post" asp-page-handler="ChangeRole" asp-route-id="@user.Id" class="form-role">
                            <select name="NewRole" class="select-role">
                                <option value="Etudiant">Etudiant</option>
                                <option value="Enseignant">Enseignant</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <button type="submit" class="btn-modifier">💼 Modifier</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Aucun utilisateur trouvé.</p>
}
