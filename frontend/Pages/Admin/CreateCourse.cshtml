@page
@model frontend.Pages.Admin.CreateCourseModel
@{
    ViewData["Title"] = "Créer un cours";
}

<style>
    .form-container {
        padding: 1.5rem;
        max-width: 640px;
        margin: auto;
        background-color: #ffffff;
        border-radius: 0.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .form-container h2 {
        font-size: 1.5rem;
        font-weight: bold;
        color: #4338CA; /* Indigo-700 */
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151; /* Gray-700 */
        margin-bottom: 0.25rem;
    }

    .form-input,
    .form-textarea,
    .form-select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #D1D5DB;
        border-radius: 0.375rem;
        font-size: 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-input:focus,
    .form-textarea:focus,
    .form-select:focus {
        border-color: #6366F1; /* Indigo-500 */
        outline: none;
        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.3);
    }

    .form-textarea {
        resize: vertical;
    }

    .validation-error {
        font-size: 0.875rem;
        color: #DC2626; /* Red-500 */
    }

    .btn-submit {
        background-color: #4F46E5; /* Indigo-600 */
        color: white;
        padding: 0.5rem 1.25rem;
        border: none;
        border-radius: 0.375rem;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-submit:hover {
        background-color: #4338CA; /* Indigo-700 */
    }

    .success-message {
        margin-top: 1rem;
        color: #059669; /* Green-600 */
        font-weight: 500;
    }
</style>

<div class="form-container">
    <h2>📘 Créer un nouveau cours</h2>

    <form method="post">
        <div class="form-group">
            <label asp-for="Course.Titre" class="form-label">Titre du cours</label>
            <input asp-for="Course.Titre" class="form-input" />
            <span asp-validation-for="Course.Titre" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Course.Description" class="form-label">Description</label>
            <textarea asp-for="Course.Description" rows="4" class="form-textarea"></textarea>
            <span asp-validation-for="Course.Description" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Course.EnseignantId" class="form-label">Enseignant</label>
            <select asp-for="Course.EnseignantId" class="form-select">
                <option value="">-- Sélectionner un enseignant --</option>
                @foreach (var enseignant in Model.Enseignants)
                {
                    <option value="@enseignant.Id">@enseignant.NomComplet</option>
                }
            </select>
            <span asp-validation-for="Course.EnseignantId" class="validation-error"></span>
        </div>

        <button type="submit" class="btn-submit">
             Créer le cours
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p class="success-message">@Model.Message</p>
    }
</div>
