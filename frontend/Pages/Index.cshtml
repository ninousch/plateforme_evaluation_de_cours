@page
@model frontend.Pages.IndexModel
@{
    ViewData["Title"] = "Accueil";
}



    <style>
     body {
        
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
         background-image: url('../images/esgis.webp');
         background-color: #030303;
         background-repeat: no-repeat;
        color: #010101;
        
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
        background-position: center;
        height: 100%;
        width: 100%;
    }

    h1 {
        font-size: 2.5rem;
        margin-top: 12%;
        margin-bottom: 20%;
       
    }

    a.connexion-link {
        display: inline-block;
        background-color: #3b82f6; /* bleu */
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.375rem;
        text-decoration: none;
        font-weight: 600;
        transition: background-color 0.3s ease;
        box-shadow: 0 4px 6px rgb(59 130 246 / 0.4);
    }

    a.connexion-link:hover {
        background-color: #2563eb;
        box-shadow: 0 6px 8px rgb(37 99 235 / 0.6);
    }
</style>

<body>
    <h1>Bienvenue sur la page d'accueil</h1>

<a href="/Auth/Login" class="connexion-link">Connexion</a>
</body>


