@page
@model frontend.Pages.Student.DashboardStudentModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-container {
        display: flex;
        min-height: 100vh;
        font-family: Arial, sans-serif;
    }

    .sidebar {
        width: 250px;
        background-color: #343a40;
        padding: 20px;
        color: white;
    }

    .sidebar h2 {
        font-size: 1.3rem;
        margin-bottom: 1.5rem;
    }

    .sidebar a {
        display: block;
        color: #ccc;
        margin-bottom: 10px;
        text-decoration: none;
        padding: 10px;
        border-radius: 4px;
        cursor: pointer;
    }

    .sidebar a:hover {
        background-color: #495057;
        color: white;
    }

    .main-content {
        flex-grow: 1;
        padding: 0;
        background-color: #f8f9fa;
        overflow-y: auto;
    }

    iframe {
        width: 100%;
        height: 100vh;
        border: none;
    }

    .user-info {
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: #ddd;
    }
</style>

<div class="dashboard-container">
    <div class="sidebar">
        
    <h2>Student</h2>

    @if (Model.UserEmail != null)
    {
        <div class="user-info">
            <div><strong>Email :</strong> @Model.UserEmail</div>
            <div><strong>Rôles :</strong> @string.Join(", ", Model.UserRoles ?? new string[] { "Aucun" })</div>
        </div>
    }

    
    <a href="/Student/MesCours" class="nav-link">Mes Cours</a>
    <a href="/Student/Evaluate" class="nav-link">Noter Cours</a>
   

    <form method="post" asp-page-handler="Logout">
        <button type="submit">Se déconnecter</button>
    </form>
</div>


    <div class="main-content">
        <iframe id="content-frame" src=""></iframe>
    </div>
</div>

@section Scripts {
    <script>
        const iframe = document.getElementById('content-frame');
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const url = this.getAttribute('href');
                iframe.src = url;
            });
        });

        // Charger une page par défaut dans l'iframe au chargement
        iframe.src = "/Student/MesCours";
    </script>
}
