@page
@model frontend.Pages.Student.MesCoursModel
@{
    ViewData["Title"] = "Mes Cours";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f0f2f5;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 30px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    h2 {
        text-align: center;
        color: #2c3e50;
        font-size: 2rem;
        margin-bottom: 30px;
        border-bottom: 2px solid #e0e0e0;
        padding-bottom: 10px;
    }

    .no-courses {
        text-align: center;
        color: #999;
        font-style: italic;
        margin-top: 20px;
        font-size: 1.1rem;
    }

    ul.course-list {
        list-style-type: none;
        padding: 0;
    }

    .course-item {
        background-color: #fafafa;
        border: 1px solid #e1e1e1;
        padding: 20px 25px;
        margin-bottom: 20px;
        border-radius: 8px;
        transition: box-shadow 0.3s ease;
    }

    .course-item:hover {
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
        background-color: #f5faff;
    }

    .course-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #1a73e8;
        margin-bottom: 8px;
    }

    .course-desc {
        color: #555;
        margin-bottom: 10px;
        font-size: 1rem;
    }

    .course-info {
        font-size: 0.95rem;
        color: #666;
        margin-bottom: 8px;
    }

    .feedback-box {
        background-color: #e8f5e9;
        padding: 15px;
        border-radius: 6px;
        border-left: 4px solid #34a853;
        margin-top: 15px;
        font-size: 0.95rem;
    }

    .feedback-box strong {
        display: inline-block;
        width: 120px;
        color: #2e7d32;
    }
</style>

<div class="container">
    <h2>📚 Mes Cours</h2>

    @if (Model.CoursList?.Any() != true)
    {
        <div class="no-courses">Vous n'êtes inscrit à aucun cours.</div>
    }
    else
    {
        <ul class="course-list">
            @foreach (var cours in Model.CoursList!)
            {
                <li class="course-item">
                    <div class="course-title">@cours.Titre</div>
                    <div class="course-desc">@cours.Description</div>
                    <div class="course-info">
                        👨‍🏫 Enseignant : <strong>@cours.EnseignantNomComplet</strong><br />
                        🗓️ Publié le : @cours.DatePublication.ToString("dd/MM/yyyy")
                    </div>

                    @if (cours.Note != null)
                    {
                        <div class="feedback-box">
                            <div><strong>Votre note :</strong> @cours.Note / 5</div>
                            <div><strong>Commentaire :</strong> @cours.Commentaire</div>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>
